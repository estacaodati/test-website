# Configurações de Produção

# Cal.com - Agendamento de consultas
# Substitua "seu-usuario" pelo seu nome de usuário no Cal.com
VITE_CAL_BOOKING_URL=https://cal.com/seu-usuario

# Google Analytics - Rastreamento de visitas
# Substitua pelo seu Measurement ID do Google Analytics GA4
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Email de contato (opcional)
# Usado para configurações futuras de email
VITE_CONTACT_EMAIL=seu-email@exemplo.com